# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# No JWT secret needed -- tokens are verified against Supabase's public JWKS
# endpoint (derived from SUPABASE_URL), which works whether the project uses
# the legacy shared-secret system or the newer asymmetric signing keys.

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# TextBelt (https://textbelt.com) -- sends the real Level 2/3 escalation alert
# as an SMS. A single HTTP API, no carrier registration or recipient opt-in
# required (unlike real SMS via Twilio, which needs A2P 10DLC registration --
# days of approval, doesn't fit a hackathon timeline).
# Leave unset to run with sending disabled (alerts still generate and are
# visible via the public share link either way).
TEXTBELT_API_KEY=your-textbelt-api-key

# CORS: the frontend origin allowed to call this API. Use * for local hackathon demo.
FRONTEND_ORIGIN=*

# Base URL the contact-facing app is served from, used to build shareable alert links
PUBLIC_BASE_URL=http://localhost:5173
