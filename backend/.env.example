# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Project Settings -> API -> JWT Settings -> JWT Secret (used to verify Supabase Auth tokens locally)
SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# CORS: the frontend origin allowed to call this API. Use * for local hackathon demo.
FRONTEND_ORIGIN=*

# Base URL the contact-facing app is served from, used to build shareable alert links
PUBLIC_BASE_URL=http://localhost:5173
