# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# No JWT secret needed -- tokens are verified against Supabase's public JWKS
# endpoint (derived from SUPABASE_URL), which works whether the project uses
# the legacy shared-secret system or the newer asymmetric signing keys.

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# CORS: the frontend origin allowed to call this API. Use * for local hackathon demo.
FRONTEND_ORIGIN=*

# Base URL the contact-facing app is served from, used to build shareable alert links
PUBLIC_BASE_URL=http://localhost:5173
